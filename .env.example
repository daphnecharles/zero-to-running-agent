# Copy this file to .env and fill in ONE of the two keys.

# Which model to use. claude (default), gemini (free backup) or mock (no key needed).
MODEL_PROVIDER=claude

# Claude. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Gemini free tier. Get a key at https://aistudio.google.com (no credit card).
# Confirm the free Flash Lite model id on AI Studio's rate limit page.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Check stage. Set to true to actually request each CFP link (needs good wifi).
CHECK_LINKS_LIVE=false

# Exercise 2 failure demo. Lets the model suggest conferences from its own memory.
LET_MODEL_SUGGEST=false
